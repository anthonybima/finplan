{$SITE_ADDRESS:localhost} {
  root * /srv/finplan
  encode zstd gzip
  header {
    Content-Security-Policy "default-src 'self'; script-src 'self' https://s3.tradingview.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.bitget.com https://openapi.bittime.com https://api.alpaca.markets https://paper-api.alpaca.markets https://mcp.pluang.com https://api.anthropic.com https://www.googleapis.com https://query1.finance.yahoo.com https://query2.finance.yahoo.com https://news.google.com https://www.cnbcindonesia.com https://data.alpaca.markets https://feeds.content.dowjones.io https://rss.nytimes.com https://www.bloomberg.com https://feeds.bloomberg.com https://www.investing.com https://api.allorigins.win https://corsproxy.io; frame-src https://*.tradingview.com https://www.tradingview-widget.com https://ssltvc.investing.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'"
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), interest-cohort=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    X-Robots-Tag "noindex, nofollow, noarchive"
    -Server
  }
  @immutable path /assets/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  @nocache path /sw.js /index.html / /oauth-google.html
  header @nocache Cache-Control "no-cache"
  try_files {path} /index.html
  file_server
}
