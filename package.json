{
  "name": "finplan",
  "productName": "FinPlan",
  "version": "1.0.0",
  "description": "Personal financial plan, analyst, manager & risk advisor",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "vite build && npx cap sync",
    "cap:android": "vite build && npx cap sync android && npx cap open android",
    "cap:ios": "vite build && npx cap sync ios && npx cap open ios",
    "build:web": "tsc --noEmit && vite build --mode web && node scripts-gen-headers.cjs dist-web",
    "audit": "npm audit --omit=dev"
  },
  "build": {
    "appId": "com.finplan.personal",
    "productName": "FinPlan",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "papaparse": "^5.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "lucide-react": "^1.70.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/papaparse": "^5.5.2",
    "vite-plugin-singlefile": "^2.3.4",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}